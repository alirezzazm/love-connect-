# کپی به /etc/love-connect.env روی سرور، سپس:
#   sudo chown root:root /etc/love-connect.env
#   sudo chmod 600 /etc/love-connect.env
#
# هیچ‌کدام از این مقادیر نباید داخل گیت باشند.

DATABASE_URL="file:/var/lib/love-connect/app.db"

ADMIN_USERNAME="نام-کاربری"
ADMIN_PASSWORD="رمز-قوی-و-تازه"

# با این بساز:  openssl rand -base64 32
AUTH_SECRET="کلید-تصادفی-۳۲-کاراکتری"

# دامنه‌ای که لینک‌های دعوت با آن ساخته می‌شوند
NEXT_PUBLIC_SITE_URL="https://dl193.ir"
